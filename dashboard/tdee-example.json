{
  "title": "Nutrition calculations",
  "views": [
    {
      "title": "Calculations",
      "path": "calculations",
      "icon": "mdi:calculator",
      "cards": [
        {
          "type": "entities",
          "title": "Tracking and weight-change goal",
          "show_header_toggle": false,
          "entities": [
            "switch.calorie_tracker_adaptive_tdee",
            "switch.calorie_tracker_automatic_nutrition_goals",
            "number.calorie_tracker_weekly_weight_change_goal"
          ]
        },
        {
          "type": "entities",
          "title": "TDEE and daily requirements",
          "entities": [
            "sensor.calorie_tracker_estimated_tdee",
            "sensor.calorie_tracker_tracked_weight",
            "sensor.calorie_tracker_adaptive_calories_target",
            "sensor.calorie_tracker_adaptive_protein_target",
            "sensor.calorie_tracker_adaptive_fat_target",
            "sensor.calorie_tracker_adaptive_carbohydrates_target"
          ]
        },
        {
          "type": "markdown",
          "content": "{% set phase = state_attr('sensor.calorie_tracker_estimated_tdee', 'status') %}\n{% set labels = {'disabled': 'Tracking disabled', 'waiting_for_body_stats': 'Waiting for starting weight and body fat', 'waiting_for_start_date': 'Waiting for the starting date', 'initial_estimate': 'Initial estimate (calibration in progress)', 'adaptive': 'Based on completed weight and intake weeks', 'invalid_targets': 'Adjust the weekly goal: no valid calorie or macro targets'} %}\n**Phase:** {{ labels.get(phase, 'Measurements not available') }}\n\n**Calibrated weeks:** {{ state_attr('sensor.calorie_tracker_estimated_tdee', 'calibration_weeks') or 0 }}\n\nPositive weekly change means gain; negative means loss. Keep starting body stats fixed. Log complete diary days; finished weeks need at least four logged days for calibration.\n\n{% set ranges = state_attr('sensor.calorie_tracker_estimated_tdee', 'ranges') %}\n{% if ranges %}**Macro ranges (g):** Protein {{ ranges.protein[0] | round }}\u2013{{ ranges.protein[1] | round }}, fat {{ ranges.fat[0] | round }}\u2013{{ ranges.fat[1] | round }}, carbs {{ ranges.carbohydrates[0] | round }}\u2013{{ ranges.carbohydrates[1] | round }}.{% endif %}"
        },
        {
          "type": "custom:apexcharts-card",
          "header": {
            "show": true,
            "title": "Daily weight and calorie intake"
          },
          "graph_span": "90d",
          "span": {
            "end": "day"
          },
          "yaxis": [
            {
              "id": "kg",
              "decimals": 1
            },
            {
              "id": "kcal",
              "opposite": true,
              "decimals": 0
            }
          ],
          "series": [
            {
              "entity": "sensor.calorie_tracker_tdee_history",
              "name": "Weight",
              "yaxis_id": "kg",
              "type": "line",
              "color": "#ff9800",
              "data_generator": "return (entity.attributes.days || []).map(x => [new Date(x.day + 'T12:00:00').getTime(), x.weight_kg]);"
            },
            {
              "entity": "sensor.calorie_tracker_tdee_history",
              "name": "Intake",
              "yaxis_id": "kcal",
              "type": "column",
              "color": "#78909c",
              "data_generator": "return (entity.attributes.days || []).map(x => [new Date(x.day + 'T12:00:00').getTime(), x.calories]);"
            }
          ]
        },
        {
          "type": "custom:flex-table-card",
          "title": "Weekly averages and TDEE",
          "entities": {
            "include": "sensor.calorie_tracker_tdee_history"
          },
          "sort_by": "Week-",
          "css": {
            "tbody tr:nth-child(odd)": "background-color: rgba(127,127,127,0.06)"
          },
          "columns": [
            {
              "name": "Week",
              "data": "weeks",
              "modify": "x.week",
              "align": "right"
            },
            {
              "name": "Start",
              "data": "weeks",
              "modify": "x.start"
            },
            {
              "name": "Avg kg",
              "data": "weeks",
              "modify": "x.average_weight_kg == null ? \"\u2014\" : x.average_weight_kg.toFixed(2)",
              "align": "right"
            },
            {
              "name": "Avg kcal",
              "data": "weeks",
              "modify": "x.average_calories == null ? \"\u2014\" : Math.round(x.average_calories)",
              "align": "right"
            },
            {
              "name": "Change kg",
              "data": "weeks",
              "modify": "x.weight_change_kg == null ? \"\u2014\" : x.weight_change_kg.toFixed(2)",
              "align": "right"
            },
            {
              "name": "TDEE",
              "data": "weeks",
              "modify": "x.smoothed_tdee == null ? \"\u2014\" : Math.round(x.smoothed_tdee)",
              "align": "right"
            },
            {
              "name": "Weight days",
              "data": "weeks",
              "modify": "x.weight_days + \"/7\"",
              "align": "right"
            },
            {
              "name": "Intake days",
              "data": "weeks",
              "modify": "x.calorie_days + \"/7\"",
              "align": "right"
            },
            {
              "name": "Status",
              "data": "weeks",
              "modify": "!x.complete ? \"In progress\" : !x.eligible ? \"Skipped\" : x.calorie_days < 7 ? \"Usable (partial)\" : \"Complete\""
            }
          ]
        }
      ]
    }
  ]
}
